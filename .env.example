# ==============================================================================
# PAYPAWA — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# ARCHITECTURAL SECURITY RULES:
# 1. Variables prefixed with EXPO_PUBLIC_ are bundled into the client application binary.
#    ONLY public keys, URLs, and non-sensitive identifiers may use this prefix.
# 2. Variables WITHOUT the EXPO_PUBLIC_ prefix are SERVER-ONLY secrets for backend
#    services, Edge Functions, and webhooks. NEVER expose them to client bundles.
# 3. Development credentials must NEVER access Production databases or live SquadCo.
# 4. Live payment or utility keys must NEVER be committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Bundled into React Native mobile app)
# ------------------------------------------------------------------------------
# Active environment: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Supabase Public Endpoint & Anon Key (Subject to Row Level Security)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key

# Payment Gateway Public Key (For client-side checkout initiation)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Core Application Settings
EXPO_PUBLIC_DEFAULT_CURRENCY=NGN
EXPO_PUBLIC_SUPPORT_EMAIL=support@paypawa.ng
EXPO_PUBLIC_ELECTRICITY_PROVIDER=squad
EXPO_PUBLIC_SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Backend, Supabase Edge Functions & Webhooks)
# ------------------------------------------------------------------------------
# DO NOT ADD EXPO_PUBLIC_ PREFIX TO THESE VARIABLES!
# In production, set via: `supabase secrets set KEY=VALUE`

# Supabase Service Role Key (Bypasses RLS - STRICTLY SERVER ONLY)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key

# Paystack Secret Credentials & Webhook Signature Key
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SquadCo (HabariPay / GTCO) Utilities Vending Secret Key
SQUAD_SECRET_KEY=sandbox_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SQUAD_WEBHOOK_SECRET=sqsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini AI Secret Key (Server-side energy intelligence)
GEMINI_API_KEY=your_google_gemini_api_key

# Push Notifications & External Tokens
EXPO_ACCESS_TOKEN=your_expo_access_token

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT SEPARATION GUIDANCE
# ------------------------------------------------------------------------------
# LOCAL DEV:
#   EXPO_PUBLIC_APP_ENV=development
#   EXPO_PUBLIC_SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
#   PAYSTACK_SECRET_KEY=sk_test_...
#
# STAGING:
#   EXPO_PUBLIC_APP_ENV=staging
#   EXPO_PUBLIC_SQUAD_BASE_URL=https://sandbox-api-d.squadco.com
#   PAYSTACK_SECRET_KEY=sk_test_...
#
# PRODUCTION:
#   EXPO_PUBLIC_APP_ENV=production
#   EXPO_PUBLIC_SQUAD_BASE_URL=https://api-d.squadco.com
#   PAYSTACK_SECRET_KEY=sk_live_...
#   SQUAD_SECRET_KEY=live_sk_...
