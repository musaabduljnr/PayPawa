# ==============================================================================
# SMART ELECTRICITY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - Variables prefixed with EXPO_PUBLIC_ are bundled into the client application.
# - Variables WITHOUT the EXPO_PUBLIC_ prefix are SERVER-ONLY secrets for Supabase
#   Edge Functions and backend services. NEVER expose them to client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE CONFIGURATION (Bundled in React Native mobile app)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_DEFAULT_CURRENCY=NGN
EXPO_PUBLIC_SUPPORT_EMAIL=support@smartelectricity.ng

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (For Supabase Edge Functions & Webhooks)
# ------------------------------------------------------------------------------
# DO NOT ADD EXPO_PUBLIC_ PREFIX TO THESE VARIABLES!
# These must be set via `supabase secrets set KEY=VALUE` in production.

# Supabase Admin / Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Payment Gateway Secret Keys
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Utility Provider (VTpass) Credentials
VTPASS_API_KEY=your_vtpass_api_key
VTPASS_SECRET_KEY=your_vtpass_secret_key
VTPASS_PUBLIC_KEY=your_vtpass_public_key
VTPASS_BASE_URL=https://sandbox.vtpass.com/api

# Push Notifications & External Services
EXPO_ACCESS_TOKEN=your_expo_access_token
GEMINI_API_KEY=your_google_gemini_api_key
